      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Neural and Self-Report Markers of Reassurance: A Generalized Additive Modelling Approach</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jeffrey J. Kim</rdf:li>
               <rdf:li>Trent Henderson</rdf:li>
               <rdf:li>Talitha Best</rdf:li>
               <rdf:li>Ross Cunnington</rdf:li>
               <rdf:li>James N. Kirby</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Research has shown that engaging in self-reassurance, a compassionately motivated cognitive relating style, can down-regulate neural markers of threat and pain</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>compassion</rdf:li>
               <rdf:li>fMRI</rdf:li>
               <rdf:li>self-report</rdf:li>
               <rdf:li>modelling</rdf:li>
               <rdf:li>reassurance</rdf:li>
               <rdf:li>criticism</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
